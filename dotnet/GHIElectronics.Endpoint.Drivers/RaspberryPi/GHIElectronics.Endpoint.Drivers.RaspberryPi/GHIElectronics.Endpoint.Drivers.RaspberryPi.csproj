<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Endpoint</Title>
    <PackageId>GHIElectronics.Endpoint.Drivers.RaspberryPi</PackageId>
    <Description>Raspberry Pi board support for Endpoint. One package covers every Pi model this library knows (Zero 2 W today; more added in later versions).</Description>
    <Copyright>Copyright GHI Electronics, LLC 2026</Copyright>
    <PackageProjectUrl>https://ghielectronics.com/</PackageProjectUrl>
    <PackageTags>Endpoint</PackageTags>
    <AssemblyVersion>0.5.3</AssemblyVersion>
    <FileVersion>0.5.3</FileVersion>
    <Version>0.5.3-preview</Version>
    <Authors>GHI Electronics, LLC</Authors>
    <Owners>GHI Electronics, LLC</Owners>
    <Company>GHI Electronics, LLC</Company>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\images\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- GHIElectronics.Endpoint.Core provides IBoardSupport, UnknownBoardSupport,
         the BoardSupport registry, and the chip-neutral I2cController /
         SpiController / PwmController / SerialPortController verbs. Pi driver
         plugs into this one-way; Core has no reverse knowledge of Pi. -->
    <ProjectReference Include="..\..\..\..\..\Endpoint-Libraries\Dotnet\GHIElectronics.Endpoint.Libraries\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="call ..\..\dopacknuget.bat $(MSBuildProjectName)" />
  </Target>

</Project>
