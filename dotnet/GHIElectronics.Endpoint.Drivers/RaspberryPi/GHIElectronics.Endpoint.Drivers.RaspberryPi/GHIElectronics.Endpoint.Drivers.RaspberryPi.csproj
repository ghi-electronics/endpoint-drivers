<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Endpoint</Title>
    <PackageId>GHIElectronics.Endpoint.Drivers.RaspberryPi</PackageId>
    <Description>Raspberry Pi board support for Endpoint. One package covers every Pi model this library knows (Zero 2 W today; more added in later versions).</Description>
    <Copyright>Copyright GHI Electronics, LLC 2026</Copyright>
    <PackageProjectUrl>https://ghielectronics.com/</PackageProjectUrl>
    <PackageTags>Endpoint</PackageTags>
    <AssemblyVersion>0.5.4</AssemblyVersion>
    <FileVersion>0.5.4</FileVersion>
    <Version>0.5.4-preview</Version>
    <Authors>GHI Electronics, LLC</Authors>
    <Owners>GHI Electronics, LLC</Owners>
    <Company>GHI Electronics, LLC</Company>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\images\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>

    <!-- Native libendpoint-zero2w per RID. Shipped in the standard NuGet
         runtimes/<rid>/native/ layout so .NET's RID-based asset resolution
         picks the matching .so at publish / F5 time. The file is RENAMED to
         libendpoint-zero2w.so (drop the -arm / -arm64 suffix) because
         DllImport("endpoint-zero2w") in Zero2WNativeLoader.cs looks for an
         unsuffixed name; RID folders already disambiguate the arch.
         Source: ../../../../cpp/.../RaspberryPi/.../native/build/linux-<arch>/
         built via cmake preset endpoint-zero2w-<arch>. ci_build.bat
         step 4 runs those cmake builds before the dotnet pack so the files
         exist. Condition=Exists keeps dev builds (without the .so built
         yet) from erroring. -->
    <None Include="..\..\..\..\cpp\GHIElectronics.Endpoint.Drivers\RaspberryPi\GHIElectronics.Endpoint.Drivers.RaspberryPi\native\build\linux-arm\libendpoint-zero2w-arm.so"
          Condition="Exists('..\..\..\..\cpp\GHIElectronics.Endpoint.Drivers\RaspberryPi\GHIElectronics.Endpoint.Drivers.RaspberryPi\native\build\linux-arm\libendpoint-zero2w-arm.so')"
          Pack="true"
          PackagePath="runtimes/linux-arm/native/libendpoint-zero2w.so"
          Visible="false" />
    <None Include="..\..\..\..\cpp\GHIElectronics.Endpoint.Drivers\RaspberryPi\GHIElectronics.Endpoint.Drivers.RaspberryPi\native\build\linux-arm64\libendpoint-zero2w-arm64.so"
          Condition="Exists('..\..\..\..\cpp\GHIElectronics.Endpoint.Drivers\RaspberryPi\GHIElectronics.Endpoint.Drivers.RaspberryPi\native\build\linux-arm64\libendpoint-zero2w-arm64.so')"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/libendpoint-zero2w.so"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- GHIElectronics.Endpoint.Core provides IBoardSupport, UnknownBoardSupport,
         the BoardSupport registry, and the chip-neutral I2cController /
         SpiController / PwmController / SerialPortController verbs. Pi driver
         plugs into this one-way; Core has no reverse knowledge of Pi. -->
    <ProjectReference Include="..\..\..\..\..\Endpoint-Libraries\Dotnet\GHIElectronics.Endpoint.Libraries\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="call ..\..\dopacknuget.bat $(MSBuildProjectName)" />
  </Target>

</Project>
